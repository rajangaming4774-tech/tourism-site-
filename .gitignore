.vercel

# Reference photographs and photogrammetry working set: several GB of Commons
# images that nothing in the site loads. Regenerate with
#   WIKI_CONTACT=you@example.com node scripts/fetch-shore-temple-photos.js
# The manifest and credits are small and ARE tracked, so what the folder should
# contain stays under version control even though the pixels do not.
assets/reference/shore-temple/*
!assets/reference/shore-temple/manifest.json
!assets/reference/shore-temple/SOURCES.md
!assets/reference/shore-temple/photogrammetry/
assets/reference/shore-temple/photogrammetry/*
!assets/reference/shore-temple/photogrammetry/README.md
!assets/reference/shore-temple/photogrammetry/dataset.json
!assets/reference/shore-temple/photogrammetry/geo.txt
!assets/reference/shore-temple/photogrammetry/camera-stations.geojson

# The Pancha Rathas reference set, fetched the same way (102 MB of CC BY-SA
# Commons images): pixels ignored, manifest and credits tracked; the gridded
# measuring copies are regenerated by build-shore-temple-measure.js --rulers,
# but the pixel picks read off them ARE the measurement and are tracked.
assets/reference/pancha-rathas/*
!assets/reference/pancha-rathas/manifest.json
!assets/reference/pancha-rathas/SOURCES.md
!assets/reference/pancha-rathas/measure/
assets/reference/pancha-rathas/measure/*
!assets/reference/pancha-rathas/measure/picks.json

# Fetch caches, regenerated on demand.
scripts/.shore-temple-cache.json
scripts/.shore-temple-survey.json
scripts/.pancha-rathas-cache.json
.claude/scheduled_tasks.lock
